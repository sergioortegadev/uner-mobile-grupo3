# Copiá este archivo como `.env.local` (queda fuera de git) y reiniciá Expo: `npx expo start -c`

# false = usa la API real; sin esta variable (o con true) la app usa los datos de prueba (mocks).
EXPO_PUBLIC_USE_MOCK=false

# Dirección de la API. El celular NO llega a "localhost": usá la IP de la compu donde corre Docker.
#   Celular físico o simulador de iOS:  http://<IP-de-la-compu>:3000
#   Emulador de Android en la misma compu: http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=http://192.168.0.10:3000
