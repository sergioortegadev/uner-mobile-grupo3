{
  "expo": {
    "name": "uner-mobile-grupo-3",
    "slug": "uner-mobile-grupo-3",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "unermobilegrupo3",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Permitir a $(PRODUCT_NAME) acceder al micrófono para grabar audios."
        }
      ],
      "expo-asset",
      "@react-native-vector-icons/ionicons",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Usamos la cámara para que saques la foto del problema que reportas.",
          "photosPermission": "Accedemos a tus fotos para que adjuntes una imagen del problema."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Esta aplicación necesita acceder a tu ubicación para geolocalizar los reportes."
        }
      ],
      "expo-sqlite",
      "expo-background-task",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2e9098a7-e9ea-401c-bb30-f88aea16d882"
      }
    },
    "owner": "uner-mobile-grupo-3"
  }
}
